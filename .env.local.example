# Copier en .env.local et remplir pour brancher Supabase + OpenAI réels.
# Sans ces variables, l'app tourne en mode mock complet (auth locale + IA simulée).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
# Veille (web search) — gpt-4o (supporte le tool web_search_preview)
OPENAI_WATCH_MODEL=gpt-4o
# Questionnaire + plan + posts — économique
OPENAI_TEXT_MODEL=gpt-4o-mini
# Image
OPENAI_IMAGE_MODEL=gpt-image-1
